# Server
PORT=3000

# Instantly API
# Get from: https://app.instantly.ai/app/settings/integrations
INSTANTLY_API_KEY=your_instantly_api_key_here

# Clay Webhook Secret (optional - for signature verification)
# Set this in your Clay webhook settings
CLAY_WEBHOOK_SECRET=your_clay_webhook_secret_here

# Poll interval for Instantly API (milliseconds)
# Default: 30000 (30 seconds)
POLL_INTERVAL_MS=30000
